# Copy to .env — docker compose reads it automatically.
BUS=rabbit
RABBIT_URL=amqp://guest:guest@rabbitmq:5672/
DATABASE_URL=postgresql://rail:rail@db:5432/rail
SIM_EPOCH=2026-10-02T07:55:00+05:00
JWT_SECRET=change-me
AUTH_ENABLED=false
LOG_LEVEL=INFO

# Host ports (docker compose); container ports are fixed.
API_PORT=8000
WEB_PORT=8080
RABBITMQ_MGMT_PORT=15672

# Auth users (CLAUDE.md §16.1)
DISPATCHER_LOGIN=dispatcher
DISPATCHER_PASSWORD=dispatcher
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
