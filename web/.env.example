# Учётные записи прототипа (базовая аутентификация). Секреты — только через переменные окружения.
VITE_DISPATCHER_LOGIN=dispatcher
VITE_DISPATCHER_PASSWORD=change-me
VITE_ADMIN_LOGIN=admin
VITE_ADMIN_PASSWORD=change-me-too
VITE_INSTRUCTOR_LOGIN=instructor
VITE_INSTRUCTOR_PASSWORD=change-me-three

# Источник данных: пусто — встроенный движок (демо без сервера); live — бэкенд команды по REST + WebSocket.
VITE_DATA_SOURCE=
# Адрес бэкенда для dev-прокси и пути API (в ТЗ §16.2 — /api/v1, текущий бэкенд отдаёт /api).
VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE=/api
VITE_WS_PATH=/ws
# SIM_EPOCH сервера: sim_time — секунды от этого момента (если сервер не присылает его в снимке).
VITE_SIM_EPOCH=07:55
